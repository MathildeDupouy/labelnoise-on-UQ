{
    "name": "Exp_ClassifESRmulti_1DCNNTransf_balancedGCE_q1_nodropout",
    "description": "",
    "device": "cuda",
    "nb_epochs": 100,
    "nb inference": 1,
    "batch size": [
        32,
        32
    ],
    "model": {
        "name": "time1Dcnntransformer",
        "args": {
            "in_channels": 1,
            "nhead": 4,
            "d_hid": 8,
            "nlayers": 4,
            "dropout": 0.0,
            "d_model": 64,
            "n_conv_layers": 2,
            "nb_features_projection": 4,
            "num_classes": 5
        }
    },
    "optimizer": {
        "name": "Noam",
        "args": {
            "lr": 0.3,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-16,
            "optimized_update": true,
            "amsgrad": true,
            "warmup": 4000
        }
    },
    "dataset": {
        "dataset type": "ESR",
        "csv path": "path/to//data/EEG_Epileptic_Seizure_Recognition/Epileptic_Seizure_Recognition.csv",
        "test size": 0.2,
        "args": {
            "constructor": "EEG_audio_constructor",
            "constructor_args": {},
            "noise_rate": 0.6,
            "noise_type": "multi-target",
            "normalize": true
        }
    },
    "train labels": {
        "labels": [
            "multi-target"
        ],
        "loss": [
            "weighted GCE"
        ],
        "weight": [
            1
        ],
        "prediction position": [
            0
        ],
        "args": [
            {
                "q": 1
            }
        ]
    },
    "test labels": [
        "multi-target"
    ],
    "projection": {
        "name": "TSNE",
        "args": {
            "n_components": 2,
            "perplexity": 40,
            "early_exaggeration": 5,
            "learning_rate": 1000,
            "max_iter": 3000,
            "n_jobs": 4
        }
    },
    "uncertainty": [
        {
            "name": "MCdropout entropy",
            "prediction position": [
                0
            ],
            "labels": [
                "multi-target"
            ]
        }
    ],
    "evaluation": {
        "all": {
            "labels": [
                "multi-target"
            ],
            "metric": [
                "MCC multi-target",
                "F1 multi-target",
                "acc multi-target",
                "balanced acc multi-target",
                "top-2 acc multi-target",
                "classification report multi-target"
            ],
            "args": [
                {},
                {
                    "average": "macro"
                },
                {},
                {},
                {},
                {
                    "output_dict": true
                }
            ]
        },
        "train": {
            "labels": [],
            "metric": []
        },
        "test": {
            "labels": [],
            "metric": []
        }
    }
}